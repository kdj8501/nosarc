APP_NAME=Nos Arc
APP_ENV=development
PORT=3000
NOSARC_ACCESS_PASSWORD=change-this-password
NOSARC_ACCESS_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-long-random-value
DATABASE_PATH=./data/nosarc.db
MEDIA_ROOT=./data/media
MAX_UPLOAD_BYTES=1073741824
MAX_PAGES_PER_CHAPTER=500
MAX_PAGE_BYTES=67108864
MAX_EXTRACTED_BYTES=536870912
PDF_RENDER_WIDTH=1600
PROCESSING_MAX_SIDE=2000
PROCESSING_MAX_PIXELS=4000000
MAX_SOURCE_PIXELS=80000000
OCR_PROVIDER=manga-ocr
OCR_LANGUAGE=jpn
OCR_LANG_PATH=
OCR_CACHE_PATH=./data/tesseract
OCR_MIN_CONFIDENCE=0.15
OCR_MANGA_MODEL=kha-white/manga-ocr-base
OCR_MANGA_CACHE_PATH=./data/models/huggingface
OCR_MANGA_PADDING=0.12
OCR_TEXT_DETECTOR_MODEL_PATH=./data/models/comictextdetector.pt.onnx
INPAINT_PROVIDER=lama
INPAINT_MODEL_PATH=./data/models/lama/inpainting_lama_2025jan.onnx
INPAINT_WORK_PATH=./data/inpaint
INPAINT_THREADS=1
INPAINT_PADDING=0.12
LETTERING_FONT_PATH=C:\Windows\Fonts\malgun.ttf
AI_TRANSLATION_PROVIDER=ctranslate2
AI_TRANSLATION_OLLAMA_URL=http://127.0.0.1:11434
AI_TRANSLATION_OLLAMA_MODEL=qwen3:8b
AI_TRANSLATION_OLLAMA_TIMEOUT_MS=300000
AI_TRANSLATION_OLLAMA_BATCH_SIZE=1
AI_TRANSLATION_OLLAMA_THINK=false
AI_TRANSLATION_OLLAMA_POLISH=false
AI_WORKER_COMMAND=python
AI_WORKER_SCRIPT=./ai-worker/worker.py
AI_TRANSLATION_MODEL_FAMILY=nllb
AI_TRANSLATION_MODEL_PATH=./data/models/nllb-200-distilled-600M-ct2
AI_TRANSLATION_TOKENIZER_PATH=./data/models/nllb-200-distilled-600M
AI_TRANSLATION_SOURCE_CODE=jpn_Jpan
AI_TRANSLATION_TARGET_CODE=kor_Hang
AI_TRANSLATION_COMPUTE_TYPE=int8
AI_TRANSLATION_BEAM_SIZE=4
AI_TRANSLATION_BATCH_SIZE=8
AI_WORKER_THREADS=1
